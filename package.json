{
  "name": "perspectra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "astro sync && tsc --noEmit",
    "verify": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm coverage && pnpm test:integration && pnpm build",
    "verify:full": "pnpm verify && pnpm smoke && pnpm test:e2e",
    "smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "perf:lighthouse": "playwright test --grep @perf",
    "db:push": "echo \"db:push reserved for phase 3\"",
    "db:seed": "echo \"db:seed reserved for phase 3\""
  },
  "dependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@neondatabase/serverless": "1.2.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "10.0.0-alpha.6",
    "astro": "7.4.13",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.21",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ts-fsrs": "6.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "@playwright/test": "1.65.1",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.1",
    "chrome-launcher": "1.2.0",
    "drizzle-kit": "0.31.11",
    "lighthouse": "13.6.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
