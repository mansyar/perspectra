---
import { createBadgeService } from '../../api/src/lib/badge';
import { SiteHeader } from '../components/layout/SiteHeader';
import '../styles/global.css';

// Static fixtures are public sample data, never deployment credentials.
const FIXTURE_SECRET = 'public-browser-fixture-secret';
const fixtureService = createBadgeService(FIXTURE_SECRET);
const fixture = await fixtureService.issue({
  hotspots: ['cortex', 'hippocampus'],
  lessonId: 'brain',
  mastery: 0.91,
  userId: 'fixture-learner',
  now: new Date('2026-11-24T00:00:00.000Z'),
});
const fixtureVerification = await fixtureService.verify(fixture.credential);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Verify a Perspectra Open Badge credential." />
    <title>Verify credential — Perspectra</title>
  </head>
  <body>
    <SiteHeader client:load current="verify" returnTo="/verify/" />
    <main class="page">
      <h1>Credential verification</h1>
      <form class="verify-form" data-verify-form>
        <label for="verify-credential">Encoded credential</label>
        <input
          autocomplete="off"
          data-verify-input
          id="verify-credential"
          name="credential"
          placeholder="Paste a credential to check its signature"
          type="text"
        />
        <button type="submit">Verify credential</button>
      </form>
      <p data-verify-status role="status">
        Checking credential…
      </p>
      <dl data-verify-details hidden>
        <dt>Achievement</dt>
        <dd data-verify-achievement></dd>
        <dt>Narrative</dt>
        <dd data-verify-narrative></dd>
        <dt>Issuer</dt>
        <dd data-verify-issuer></dd>
        <dt>Issued</dt>
        <dd data-verify-issued></dd>
      </dl>
      <section class="verify-fixture" aria-label="Offline sample credential">
        <h2>Non-heart sample</h2>
        <p>
          Static preview has no Worker API. This public fixture displays the signed sample prose
          only; it is not signature-verified here.
        </p>
        <button
          data-fixture-button
          data-fixture-credential={fixture.credential}
          data-fixture-parsed={JSON.stringify(fixtureVerification.credential ?? {})}
          type="button"
        >
          Show brain sample narrative
        </button>
      </section>
    </main>
  </body>
</html>

<script>
  function setText(selector: string, value: string): void {
    const node = document.querySelector<HTMLElement>(selector);
    if (node) {
      node.textContent = value;
    }
  }

  function renderCredential(
    parsed: Record<string, unknown>,
    statusText: string,
    markValid: boolean,
  ): void {
    const subject = parsed.credentialSubject as
      | {
          achievement?: {
            criteria?: { narrative?: string };
            description?: string;
            name?: string;
          };
        }
      | undefined;
    const issuer = parsed.issuer as { name?: string } | undefined;
    setText('[data-verify-status]', statusText);
    setText('[data-verify-achievement]', subject?.achievement?.name ?? 'Unknown achievement');
    setText(
      '[data-verify-narrative]',
      subject?.achievement?.criteria?.narrative ?? 'No narrative supplied',
    );
    setText('[data-verify-issuer]', issuer?.name ?? 'Unknown issuer');
    setText('[data-verify-issued]', String(parsed.issuanceDate ?? 'Unknown date'));
    const details = document.querySelector<HTMLElement>('[data-verify-details]');
    if (details) {
      details.hidden = false;
    }
    const status = document.querySelector<HTMLElement>('[data-verify-status]');
    if (status) {
      if (markValid) {
        status.setAttribute('data-valid', 'true');
      } else {
        status.removeAttribute('data-valid');
      }
    }
  }

  async function verifyCredential(credential: string): Promise<void> {
    const status = document.querySelector<HTMLElement>('[data-verify-status]');
    const details = document.querySelector<HTMLElement>('[data-verify-details]');
    if (!credential) {
      setText('[data-verify-status]', 'No credential was supplied.');
      if (details) {
        details.hidden = true;
      }
      return;
    }
    try {
      const base = import.meta.env.PUBLIC_API_URL ?? '';
      const response = await fetch(`${base}/api/badge/verify`, {
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        method: 'POST',
        body: JSON.stringify({ credential }),
      });
      const result = (await response.json()) as {
        valid: boolean;
        reason?: string;
        credential?: Record<string, unknown>;
      };
      if (!response.ok || !result.valid) {
        setText('[data-verify-status]', `Invalid credential: ${result.reason ?? 'unavailable'}`);
        if (details) {
          details.hidden = true;
        }
        return;
      }
      renderCredential(result.credential ?? {}, 'Valid credential', true);
    } catch {
      setText('[data-verify-status]', 'Verification is currently unavailable.');
      if (details) {
        details.hidden = true;
      }
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-verify-form]');
  const input = document.querySelector<HTMLInputElement>('[data-verify-input]');
  const supplied = new URLSearchParams(location.search).get('credential');
  if (input && supplied) {
    input.value = supplied;
  }
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    void verifyCredential(input?.value.trim() ?? '');
  });
  void verifyCredential(supplied ?? '');

  const fixtureButton = document.querySelector<HTMLButtonElement>('[data-fixture-button]');
  fixtureButton?.addEventListener('click', () => {
    const parsed = JSON.parse(fixtureButton.dataset.fixtureParsed ?? '{}') as Record<
      string,
      unknown
    >;
    if (input) {
      input.value = fixtureButton.dataset.fixtureCredential ?? '';
    }
    renderCredential(parsed, 'Sample credential (offline fixture, not signature-verified)', false);
  });
</script>
