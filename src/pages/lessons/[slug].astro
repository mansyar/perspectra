---
import { getCollection, getEntry, render } from 'astro:content';
import { ProseHotspotBinder } from '../../components/prose/ProseHotspotBinder';
import { SceneIsland } from '../../components/scene/SceneIsland';
import { sceneManifestSchema, validateHotspotReferences } from '../../lib/scene-manifest';
import '../../styles/global.css';
import '../../styles/lesson.css';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => {
    const manifest = sceneManifestSchema.parse(entry.data);
    validateHotspotReferences(entry.body ?? '', manifest, { requireAll: true });
    return { params: { slug: entry.id } };
  });
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error('Missing lesson slug');
}
const entry = await getEntry('lessons', slug);
if (!entry) {
  throw new Error(`Unknown lesson: ${slug}`);
}
const { Content } = await render(entry);
const manifest = sceneManifestSchema.parse(entry.data);

// Resolve the manifest's model URL to the emitted asset without hard-coding a topic.
const modelAssets = import.meta.glob('../../../assets/**/*.glb', {
  query: '?url',
  import: 'default',
  eager: true,
});
const modelKey = `../../../assets/${manifest.model.src.replace(/^\/assets\//, '')}`;
const modelSrc = modelAssets[modelKey] ?? manifest.model.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={entry.data.description} />
    <title>{entry.data.title} — Perspectra</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__brand" href="/">
        Perspectra
      </a>
    </header>
    <main class="page">
      <header class="lesson-header">
        <span class="lesson-header__topic">{entry.data.topic}</span>
        <h1>{entry.data.title}</h1>
        <p class="page__intro">{entry.data.description}</p>
      </header>

      <SceneIsland client:visible manifest={manifest} modelSrc={modelSrc} />

      <div class="lesson-layout">
        <nav class="landmarks" aria-label="Lesson landmarks">
          <h2>Landmarks</h2>
          <ol>
            {manifest.hotspots.map((hotspot) => (
              <li>
                <a href={`#${hotspot.id}`}>{hotspot.label}</a>
              </li>
            ))}
          </ol>
        </nav>

        <article class="prose">
          <Content />
        </article>
      </div>
      <ProseHotspotBinder client:load />
    </main>
    <footer class="site-footer">
      <p>Open educational content. Code under MIT; shipped assets are CC0 or OFL.</p>
    </footer>
  </body>
</html>
